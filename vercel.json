{
"version": 2,
"builds": [
{
"src": "api/index.js",
"use": "@vercel/node"
},
{
"src": "*.html",
"use": "@vercel/static"
},
{
"src": "*.css",
"use": "@vercel/static"
},
{
"src": "*.js",
"use": "@vercel/static"
},
{
"src": "*.svg",
"use": "@vercel/static"
}
],
"routes": [
{
"src": "/api/state",
"dest": "/api/index.js"
},
{
"src": "/api/state/(.*)",
"dest": "/api/index.js?key=$1"
},
{
"src": "/(.*)",
"dest": "/$1"
}
]
}
