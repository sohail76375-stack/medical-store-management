# Server environment variables (set in your hosting dashboard, not in frontend code)
# Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Generate a long random value (at least 32 characters). Never commit the real value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Required to prevent arbitrary public account creation. Share privately with authorized staff.
REGISTRATION_INVITE_CODE=replace-with-a-long-private-invite-code
# Optional: set to disable SSL only for a local development database.
# PGSSL=disable
